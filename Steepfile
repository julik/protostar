# frozen_string_literal: true

D = Steep::Diagnostic

# lib/ against the signatures generated from its own inline RBS (rake steep)
target :lib do
  signature "sig"
  check "lib"
  # Generated by script/bootstrap.rb; their signatures come from the same emitter
  ignore "lib/protostar/google"

  library "json", "stringio", "pp", "optparse", "fileutils", "open3", "pathname", "tmpdir"

  # The default profile adds some 600 findings, nearly all nil checks Steep
  # cannot follow and empty literals it wants annotated
  configure_code_diagnostics(D::Ruby.lenient)
end
