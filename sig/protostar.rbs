# The public API of protostar. Message classes generated with
# `protostar compile --ruby_out=... --rbs_out=...` get their own `_pb.rbs`
# describing their fields; the well-known types' signatures are under
# sig/protostar/google/protobuf/.
module Protostar
  VERSION: String

  class Error < ::StandardError
  end

  class DecodeError < Error
    attr_reader offset: ::Integer?
    def initialize: (::String message, ?offset: ::Integer?) -> void
  end

  class EncodeError < Error
  end

  class TypeError < ::TypeError
  end

  class Timestamp = Google::Protobuf::Timestamp
  class Duration = Google::Protobuf::Duration
  class Any = Google::Protobuf::Any
  class Struct = Google::Protobuf::Struct
  class Value = Google::Protobuf::Value
  class ListValue = Google::Protobuf::ListValue
  class Empty = Google::Protobuf::Empty
  class FieldMask = Google::Protobuf::FieldMask
  class DoubleValue = Google::Protobuf::DoubleValue
  class FloatValue = Google::Protobuf::FloatValue
  class Int64Value = Google::Protobuf::Int64Value
  class UInt64Value = Google::Protobuf::UInt64Value
  class Int32Value = Google::Protobuf::Int32Value
  class UInt32Value = Google::Protobuf::UInt32Value
  class BoolValue = Google::Protobuf::BoolValue
  class StringValue = Google::Protobuf::StringValue
  class BytesValue = Google::Protobuf::BytesValue

  # A field read from the wire that the message's schema does not know
  class UnknownField
    attr_reader number: ::Integer
    attr_reader wire_type: ::Integer
    attr_reader bytes: ::String
    def initialize: (::Integer number, ::Integer wire_type, ::String bytes) -> void
    def value: () -> (::Integer | ::String)
    def to_wire: () -> ::String
  end

  # The descriptors: what a .proto file declares, frozen once built
  module Schema
    class Error < Protostar::Error
    end

    class Descriptor
      def name: () -> ::String
      def full_name: () -> ::String
      def index: () -> ::Integer
      def options: () -> untyped
      def to_h: () -> ::Hash[::Symbol, untyped]
    end

    class File < Descriptor
      def package: () -> ::String
      def syntax: () -> ::Symbol
      def dependencies: () -> ::Array[::String]
      def messages: () -> ::Array[Message]
      def enums: () -> ::Array[Enum]
      def services: () -> ::Array[Service]
      def all_messages: () -> ::Array[Message]
      def all_enums: () -> ::Array[Enum]
      def find_message: (::String full_name) -> Message?
      def find_enum: (::String full_name) -> Enum?
      def serialize: (?source_info: bool, ?default_json_names: bool) -> ::String
    end

    class Message < Descriptor
      def file: () -> File
      def containing_message: () -> Message?
      def fields: () -> ::Array[Field]
      def oneofs: () -> ::Array[Oneof]
      def real_oneofs: () -> ::Array[Oneof]
      def nested_messages: () -> ::Array[Message]
      def nested_enums: () -> ::Array[Enum]
      def field: (::Integer | ::String | ::Symbol key) -> Field?
      def map_entry?: () -> bool
    end

    class Field < Descriptor
      def file: () -> File
      def containing_message: () -> Message?
      def number: () -> ::Integer
      def label: () -> ::Symbol
      def type: () -> ::Symbol
      def message_type: () -> Message?
      def enum_type: () -> Enum?
      def json_name: () -> ::String
      def oneof: () -> Oneof?
      def default: () -> untyped
      def repeated?: () -> bool
      def map?: () -> bool
      def presence?: () -> bool
    end

    class Oneof < Descriptor
      def containing_message: () -> Message
      def fields: () -> ::Array[Field]
      def synthetic?: () -> bool
    end

    class Enum < Descriptor
      def file: () -> File
      def containing_message: () -> Message?
      def values: () -> ::Array[EnumValue]
      def value: (::Integer | ::String | ::Symbol key) -> EnumValue?
      def closed?: () -> bool
      def open?: () -> bool
    end

    class EnumValue < Descriptor
      def number: () -> ::Integer
      def enum: () -> Enum
    end

    class Service < Descriptor
      def file: () -> File
    end

    class Pool
      def initialize: () -> void
      def add: (File file, ?warn: bool) -> File
      def file: (::String name) -> File?
      def files: () -> ::Array[File]
      def find_message: (::String full_name) -> Message?
      def find_enum: (::String full_name) -> Enum?
    end
  end

  # Extended by every enum Module
  module Enum
    def descriptor: () -> Schema::Enum
    def lookup: (::Integer number) -> ::Symbol?
    def resolve: (::Symbol | ::String name) -> ::Integer?
  end

  # The base class of every message class
  class Message
    type json_options = {
      ?preserve_proto_field_names: bool,
      ?preserve_proto_fieldnames: bool,
      ?emit_defaults: bool,
      ?format_enums_as_integers: bool,
      ?registry: Types::Registry?
    }

    def self.descriptor: () -> Schema::Message
    def self.decode: (::String | ::IO::Buffer bytes, ?recursion_limit: ::Integer, ?frozen: bool) -> instance
    def self.decode_delimited: (::String | ::IO::Buffer | ::IO source, ?recursion_limit: ::Integer, ?frozen: bool) -> instance?
    def self.encode: (instance message) -> ::String
    def self.decode_json: (::String json, ?ignore_unknown_fields: bool, ?registry: Types::Registry?) -> instance
    def self.encode_json: (instance message, **untyped options) -> ::String
    def self.merge: (instance a, instance b) -> instance
    def self.view: (::String | ::IO::Buffer bytes, ?offset: ::Integer, ?length: ::Integer?, ?recursion_limit: ::Integer) -> View
    def self.view_class: () -> singleton(View)
    def self.build: (?::Hash[::Symbol | ::String, untyped]? fields, **untyped) ?{ (Builder pb) -> void } -> instance
    def self.reflection: () -> Reflection

    def initialize: (?::Hash[::Symbol | ::String, untyped]? hash, **untyped fields) -> void
    def []: (::String | ::Symbol name) -> untyped
    def []=: (::String | ::Symbol name, untyped value) -> untyped
    def unknown_fields: () -> ::Array[UnknownField]
    def encode: () -> ::String
    def encode_to: [T] (T io) -> T
    def encode_delimited: () -> ::String
                        | [T] (T io) -> T
    def to_json: (?untyped state, **untyped options) -> ::String
    def to_text: (**untyped options) -> ::String
    def to_h: () -> ::Hash[::Symbol, untyped]
    def ==: (untyped other) -> bool
    def hash: () -> ::Integer
    def clone: (?freeze: bool?) -> self
    def freeze: () -> self
    def merge!: (self other) -> self
    def clear!: () -> self
    def initialized?: () -> bool
    def inspect: () -> ::String
    def pretty_print: (untyped q) -> void

    # A message class's fields by descriptor, name or number (Klass.reflection)
    class Reflection
      type field_key = ::String | ::Symbol | ::Integer | untyped

      def klass: () -> untyped
      def descriptor: () -> Schema::Message
      def fields: () -> ::Array[untyped]
      def oneofs: () -> ::Array[untyped]
      def field: (field_key key) -> untyped
      def get: (Message message, field_key key) -> untyped
      def set: (Message message, field_key key, untyped value) -> Message
      def set?: (Message message, field_key key) -> bool
      def clear: (Message message, field_key key) -> Message
      def which: (Message message, untyped oneof) -> untyped
      def message_class: (field_key key) -> untyped
      def enum_module: (field_key key) -> untyped
      def each: (Message message) { (untyped field, untyped value) -> void } -> nil
              | (Message message) -> ::Enumerator[[untyped, untyped], nil]
      def inspect: () -> ::String
    end
  end

  # A read-only message over encoded bytes; fields are decoded when read
  class View
    def self.message_class: () -> singleton(Message)
    def self.descriptor: () -> Schema::Message

    def descriptor: () -> Schema::Message
    def []: (::String | ::Symbol name) -> untyped
    def unknown_fields: () -> ::Array[UnknownField]
    def encode: () -> ::String
    def to_proto: () -> ::String
    def to_message: (?frozen: bool) -> Message
    def to_h: () -> ::Hash[::Symbol, untyped]
    def ==: (untyped other) -> bool
    def hash: () -> ::Integer
    def freeze_index: () -> self
    def inspect: () -> ::String
    def pretty_print: (untyped q) -> void
  end

  module Types
    class Registry
      def initialize: (?open_enums: bool) -> void
      def find: (::String full_name) -> (singleton(Message) | Module)?
      def file: (::String file_name) -> ::Hash[::String, singleton(Message) | Module]?
      def define: (untyped file, ?name: Module?) -> ::Hash[::String, singleton(Message) | Module]
    end

    def self.registry: () -> Registry
    def self.define: (untyped file, ?name: Module?, ?registry: Registry) -> ::Hash[::String, singleton(Message) | Module]
    def self.find: (::String full_name, ?registry: Registry) -> (singleton(Message) | Module)?
  end

  module JSON
    class Error < Protostar::Error
    end

    class ParseError < Error
      attr_reader path: ::String
      def initialize: (::String message, ?::String path) -> void
    end

    class EncodeError < Error
      attr_reader path: ::String
      def initialize: (::String message, ?::String path) -> void
    end

    def self.encode: (Message message, ?preserve_proto_field_names: bool, ?preserve_proto_fieldnames: bool,
                     ?emit_defaults: bool, ?format_enums_as_integers: bool, ?registry: Types::Registry?) -> ::String
    def self.decode: (singleton(Message) klass, ::String json, ?ignore_unknown_fields: bool,
                                     ?registry: Types::Registry?) -> Message
  end

  module Text
    class Error < Protostar::Error
    end

    class ParseError < Error
      attr_reader line: ::Integer
      attr_reader column: ::Integer
      def initialize: (::String message, ::Integer line, ::Integer column) -> void
    end

    def self.print: (Message | View message, ?single_line: bool, ?expand_any: bool, ?as_utf8: bool,
                    ?unknown_fields: bool, ?registry: Types::Registry?, ?pool: untyped) -> ::String
    def self.parse: (singleton(Message) klass, ::String text, ?allow_unknown_fields: bool,
                                    ?allow_partial: bool, ?registry: Types::Registry?, ?pool: untyped) -> Message
  end

  # Writes a message's encoding as fields are given, without building the message
  class Builder
    class Error < Protostar::Error
      attr_reader path: ::String?
      def initialize: (::String message, ?path: ::String?) -> void
    end

    interface _CacheStore
      def fetch: (untyped key, ?::Hash[::Symbol, untyped] options) { () -> ::String } -> ::String
    end

    type options = {
      ?cache_store: _CacheStore?,
      ?overwrites: bool,
      ?repeated: :append | :replace,
      ?buffer: ::Integer,
      ?chunk_nested_at: ::Integer?
    }

    # Anything that takes bytes: `write` (an IO, a socket, a Rack stream), `<<` (an Array) or `call` (a Proc)
    type sink = ::String | _Write | _Append | ^(::String bytes) -> untyped

    interface _Write
      def write: (::String bytes) -> untyped
    end

    interface _Append
      def <<: (::String bytes) -> untyped
    end

    def self.build: (untyped klass, ?cache_store: _CacheStore?, ?overwrites: bool, ?repeated: :append | :replace,
                     ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb) -> void } -> ::String
    def self.message: (untyped klass, ?cache_store: _CacheStore?, ?overwrites: bool, ?repeated: :append | :replace,
                       ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb) -> void } -> Message
    def self.write: [T < sink] (T io, untyped klass, ?cache_store: _CacheStore?, ?overwrites: bool, ?repeated: :append | :replace,
                                ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb) -> void } -> T
    def self.each: [T < sink, E] (T io, untyped klass, _Each[E] collection, ?cache_store: _CacheStore?, ?overwrites: bool,
                                  ?repeated: :append | :replace, ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb, E element) -> void } -> T
                 | [E] (nil io, untyped klass, _Each[E] collection, ?cache_store: _CacheStore?, ?overwrites: bool,
                        ?repeated: :append | :replace, ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb, E element) -> void } -> ::String
    def self.each_chunk: (untyped klass, ?cache_store: _CacheStore?, ?overwrites: bool, ?repeated: :append | :replace,
                          ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) { (Builder pb) -> void } -> ::Enumerator[::String, nil]
    def self.new: (untyped klass, ?sink? target, ?cache_store: _CacheStore?, ?overwrites: bool, ?repeated: :append | :replace,
                   ?buffer: ::Integer, ?chunk_nested_at: ::Integer?) -> Builder
    def self.for: (untyped klass) -> singleton(Builder)
    def self.resolve: (untyped klass) -> singleton(Message)

    def target!: () -> untyped
    def message_class: () -> singleton(Message)
    def set!: (::String | ::Symbol name, *untyped value_and_attributes) ?{ (?untyped element) -> void } -> self
    def extract!: (untyped object, *(::String | ::Symbol) names) -> self
    def merge!: (::Hash[::String | ::Symbol, untyped] hash) -> self
    def encoded!: (::String | ::Symbol name, ::String | ::Array[::String] bytes) -> self
    def cache!: (untyped key, **untyped options) { (Builder pb) -> void } -> self
    def cache_if!: (boolish condition, untyped key, **untyped options) { (Builder pb) -> void } -> self
  end

  # Helpers mixed into the well-known types, as google-protobuf names them
  module WellKnown
    class UnexpectedStructType < Protostar::Error
    end

    module Any
      DEFAULT_PREFIX: ::String

      module ClassMethods
        def pack: (Message message, ?::String type_url_prefix) -> Google::Protobuf::Any
      end

      def pack: (Message message, ?::String type_url_prefix) -> self
      def unpack: (singleton(Message) klass) -> Message?
      def type_name: () -> ::String
      def is: (singleton(Message) klass) -> bool
    end

    module Timestamp
      def self.parts: (untyped value) -> [::Integer, ::Integer]?

      module ClassMethods
        def from_time: (::Time time) -> Google::Protobuf::Timestamp
      end

      def from_time: (::Time time) -> self
      def to_time: () -> ::Time
      def to_i: () -> ::Integer
      def to_f: () -> ::Rational
    end

    module Duration
      MAX_SECONDS: ::Integer
      NANOS: ::Integer

      def self.parts: (untyped value) -> [::Integer, ::Integer]?

      module ClassMethods
      end

      def to_f: () -> ::Float
    end

    module Struct
      module ClassMethods
        def from_hash: (::Hash[::String, untyped] hash) -> Google::Protobuf::Struct
      end

      def []: (::String key) -> untyped
      def []=: (::String key, untyped value) -> untyped
      def to_h: () -> ::Hash[::String, untyped]
      def has_key?: (::String key) -> bool
    end

    module Value
      module ClassMethods
        def from_ruby: (untyped value) -> Google::Protobuf::Value
      end

      def to_ruby: (?bool recursive) -> untyped
      def from_ruby: (untyped value) -> self
    end

    module ListValue
      include ::Enumerable[untyped]

      module ClassMethods
        def from_a: (::Array[untyped] array) -> Google::Protobuf::ListValue
      end

      def length: () -> ::Integer
      def []: (::Integer index) -> untyped
      def []=: (::Integer index, untyped value) -> untyped
      def <<: (untyped value) -> self
      def each: () { (untyped) -> void } -> self
              | () -> ::Enumerator[untyped, self]
      def to_a: () -> ::Array[untyped]
    end
  end
end
