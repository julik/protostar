  # view = Person.view(bytes)          # a String or an IO::Buffer
  # view.name                          # => "Ada"
  # view.friends[2].name               # a nested view, same buffer
  # view.encode.equal?(bytes)          # => true
  # view.to_message                    # the mutable message, decoded eagerly
  # ```
