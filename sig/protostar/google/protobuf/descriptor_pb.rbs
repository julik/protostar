          #   // ignored detached comments.
          attr_reader leading_comments(): ::String
          attr_writer leading_comments(): ::String?
          def has_leading_comments?: () -> bool
          def clear_leading_comments: () -> void

          attr_reader trailing_comments(): ::String
          attr_writer trailing_comments(): ::String?
          def has_trailing_comments?: () -> bool
          def clear_trailing_comments: () -> void

          attr_reader leading_detached_comments(): ::Array[::String]
          attr_writer leading_detached_comments(): ::Array[::String]?
        end

        type init_map = {
          ?location: (::Array[::Protostar::Google::Protobuf::SourceCodeInfo::Location | ::Protostar::Google::Protobuf::SourceCodeInfo::Location::init_map])?
