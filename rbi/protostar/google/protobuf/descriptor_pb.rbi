        EDITION_2_TEST_ONLY = ::T.let(2, ::Integer)
        EDITION_99997_TEST_ONLY = ::T.let(99997, ::Integer)
        EDITION_99998_TEST_ONLY = ::T.let(99998, ::Integer)
        EDITION_99999_TEST_ONLY = ::T.let(99999, ::Integer)

